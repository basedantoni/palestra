{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.turbo/**",
    "**/routeTree.gen.ts",
    "**/*.gen.ts"
  ],
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/__tests__/**",
        "apps/web/src/components/ui/**"
      ],
      "rules": {
        "no-shadow": "off"
      }
    },
    {
      "files": ["packages/api/src/routers/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["./*"],
                "allowImportNamePattern": "Router$",
                "message": "A router imports only sub-routers from sibling routers. Move shared helpers to packages/api/src/lib/."
              }
            ]
          }
        ]
      }
    }
  ]
}
