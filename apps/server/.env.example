# Server environment variables.
# Copy to `.env` and fill in real values: `cp apps/server/.env.example apps/server/.env`
# Validated at startup by packages/env/src/server.ts (zod) — a missing/invalid
# required var crashes the server on boot. Never commit real secrets.

# ── Required ──────────────────────────────────────────────────────────────

# Postgres connection string. Default matches packages/db/docker-compose.yml
# (host port 5433 → container 5432, db "palestra").
DATABASE_URL="postgres://postgres:password@localhost:5433/palestra"

# Better-Auth signing secret. Min 32 chars. Generate: `openssl rand -base64 32`
BETTER_AUTH_SECRET="replace-with-32+-char-random-string"

# Public base URL of this server. Used by Better-Auth for callbacks/cookies.
BETTER_AUTH_URL="http://localhost:3000"

# Allowed browser origin for CORS (the web app). Must be a full URL.
CORS_ORIGIN="http://localhost:3001"

# ── Optional ──────────────────────────────────────────────────────────────

# Comma-separated admin emails. Grants access to adminProcedure routes. Omit = no admins.
# The Market Watch worker reads it too, to notify admins of failed captures and a near-full
# database: set it as a secret on palestra-worker as well.
ADMIN_EMAILS="you@example.com"

# Runtime mode: development | production | test. Defaults to "development".
NODE_ENV="development"

# Whoop OAuth app credentials. All three required together to enable Whoop sync; omit to disable.
WHOOP_CLIENT_ID=""
WHOOP_CLIENT_SECRET=""
WHOOP_REDIRECT_URI="http://localhost:3000/api/whoop/callback"

# AES key for encrypting stored Whoop OAuth tokens. Exactly 64 hex chars (32 bytes).
# Generate: `openssl rand -hex 32`. Required if Whoop sync is enabled.
TOKEN_ENCRYPTION_KEY=""

# Shared secret for internal server-to-server endpoints. Min 32 chars.
INTERNAL_API_SECRET=""

# Cookie domain override for cross-subdomain auth in production (e.g. ".example.com").
COOKIE_DOMAIN=""

# Plaid (finance module). Encrypted access tokens reuse TOKEN_ENCRYPTION_KEY.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
# "sandbox" | "production". Defaults to sandbox.
PLAID_ENV="sandbox"
# Public URL Plaid posts SYNC_UPDATES_AVAILABLE webhooks to.
PLAID_WEBHOOK_URL="http://localhost:3000/api/plaid/webhook"
# Comma-separated Plaid products + ISO country codes.
PLAID_PRODUCTS="transactions"
PLAID_COUNTRY_CODES="US"

# SnapTrade Personal API key (Fidelity 401k / brokerage balances, KOI-318).
# All three required together; omit any to turn the daily SnapTrade capture off.
# Accounts are connected in SnapTrade's own dashboard, never in Palestra.
# Server-only: never expose with a VITE_ prefix. Rotate the key if it leaks.
SNAPTRADE_CLIENT_ID=""
SNAPTRADE_CONSUMER_KEY=""
# Email of the Palestra user who owns the Personal key's accounts.
SNAPTRADE_OWNER_EMAIL=""

# ── Worker only ───────────────────────────────────────────────────────────
# Read by the Market Watch worker (`palestra-worker`, src/worker.ts) and `pnpm market:job`,
# validated by packages/env/src/worker.ts. The web server never reads them. The worker also needs
# DATABASE_URL above.

# Tigris (S3) bucket for raw market snapshots: private, never served.
# `fly storage create -a palestra-worker` sets all five as secrets on the worker app; copy them
# here only to run market jobs locally.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3="https://fly.storage.tigris.dev"
# Tigris takes "auto". Defaults to auto.
AWS_REGION="auto"
BUCKET_NAME=""

# CardTrader self-serve API token (cardtrader.com → profile settings → API), for market.cardtrader's
# Japanese Market Prices under ADR 0007's ToS exception. Set it on the worker with
# `fly secrets set CARDTRADER_TOKEN=... -a palestra-worker`. Without it only market.cardtrader fails.
CARDTRADER_TOKEN=""

# TypeSafe API key (console.typesafe.ai), worker-only, for the Market Watch matcher's TypeSafe tier
# (KOI-371): one Choice per Marketplace Product the rule and tcgplayer_id tiers leave unmatched.
# Set it with `fly secrets set TYPESAFE_API_KEY=... -a palestra-worker`. Without it the tier is skipped.
TYPESAFE_API_KEY=""
